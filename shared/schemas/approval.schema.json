{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human Approval",
  "type": "object",
  "required": ["case_id", "action", "status", "requested_at", "requested_by_role"],
  "properties": {
    "case_id": {"type": "string"},
    "action": {"type": "string"},
    "status": {"enum": ["draft", "pending", "approved", "rejected", "returned", "expired"]},
    "requested_at": {"type": "string", "format": "date-time"},
    "requested_by_role": {"type": "string"},
    "decided_at": {"type": ["string", "null"], "format": "date-time"},
    "decided_by_role": {"type": ["string", "null"]},
    "decision_reason": {"type": ["string", "null"]},
    "evidence_ids": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
