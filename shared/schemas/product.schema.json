{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/product.schema.json",
  "title": "AI Product",
  "type": "object",
  "required": ["id", "slug", "name", "maturity", "classification", "data_policy", "production_ready"],
  "properties": {
    "id": {"type": "string", "pattern": "^P[0-9]{2}$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 3},
    "maturity": {"type": "string"},
    "classification": {"enum": ["PUBLIC", "PORTFOLIO-INTERNAL", "RESTRICTED-SOURCE"]},
    "data_policy": {"enum": ["synthetic-only", "approved-non-production", "production-approved"]},
    "production_ready": {"type": "boolean"}
  },
  "additionalProperties": true
}
