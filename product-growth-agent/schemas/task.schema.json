{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Growth Task",
  "type": "object",
  "required": ["task_id", "objective"],
  "properties": {
    "task_id": {"type": "string"},
    "objective": {"type": "string"},
    "business_context": {"type": "object", "additionalProperties": true},
    "time_horizon": {"type": ["string", "null"]},
    "population": {"type": ["string", "null"]},
    "constraints": {"type": "object", "additionalProperties": true},
    "available_sources": {"type": "array", "items": {"type": "string"}},
    "requested_output": {"type": ["string", "null"]},
    "approval_context": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": false
}
