  "gates":{
    "G0":{"name":"Intake and ownership","required_controls":["CTRL-OWNER","CTRL-PURPOSE","CTRL-INVENTORY"],"required_approver_roles":["PRODUCT_OWNER"]},
    "G1":{"name":"Value and risk triage","required_controls":["CTRL-IMPACT-ASSESSMENT","CTRL-HUMAN-OVERSIGHT"],"high_impact_controls":["CTRL-BOARD-RISK"],"required_approver_roles":["AI_GOVERNANCE_COUNCIL"]},
    "G2":{"name":"Design, data and control approval","required_controls":["CTRL-DATA","CTRL-PRIVACY-SECURITY","CTRL-EXPLAINABILITY","CTRL-ROLLBACK"],"high_impact_controls":["CTRL-SAFE-SHUTDOWN"],"required_approver_roles":["DESIGN_AUTHORITY"]},
    "G3":{"name":"Independent validation and pilot acceptance","required_controls":["CTRL-EVALUATION","CTRL-AUDIT"],"high_impact_controls":["CTRL-INDEPENDENT-TEST","CTRL-RED-TEAM"],"required_approver_roles":["INDEPENDENT_ASSURANCE"]},
    "G4":{"name":"Production deployment authorization","required_controls":["CTRL-CONTINUOUS-MONITORING","CTRL-ROLLBACK"],"high_impact_controls":["CTRL-CEO-AUTHORIZATION"],"required_approver_roles":["CEO"]}
  },
  "required_prior_approvals_by_risk":{
    "Low":["PRODUCT_OWNER","DESIGN_AUTHORITY","INDEPENDENT_ASSURANCE"],
