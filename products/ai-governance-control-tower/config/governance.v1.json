    "Moderate":["CTRL-HUMAN-OVERSIGHT","CTRL-EXPLAINABILITY","CTRL-EVALUATION","CTRL-DATA"],
    "High":["CTRL-IMPACT-ASSESSMENT","CTRL-PRIVACY-SECURITY","CTRL-INDEPENDENT-TEST","CTRL-RED-TEAM","CTRL-ROLLBACK"],
    "Critical":["CTRL-BOARD-RISK","CTRL-SAFE-SHUTDOWN","CTRL-CEO-AUTHORIZATION","CTRL-CONTINUOUS-MONITORING"]
  },
  "roles_by_tier":{
    "Low":["PRODUCT_OWNER"],"Moderate":["PRODUCT_OWNER","DESIGN_AUTHORITY"],
    "High":["AI_GOVERNANCE_COUNCIL","DOMAIN_RISK_OWNER","INDEPENDENT_ASSURANCE"],
    "Critical":["AI_GOVERNANCE_COUNCIL","DOMAIN_RISK_OWNER","INDEPENDENT_ASSURANCE","CEO"]
