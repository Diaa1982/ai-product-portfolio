    "High":["PRODUCT_OWNER","AI_GOVERNANCE_COUNCIL","DOMAIN_RISK_OWNER","DESIGN_AUTHORITY","INDEPENDENT_ASSURANCE"],
    "Critical":["PRODUCT_OWNER","AI_GOVERNANCE_COUNCIL","DOMAIN_RISK_OWNER","DESIGN_AUTHORITY","INDEPENDENT_ASSURANCE"]
