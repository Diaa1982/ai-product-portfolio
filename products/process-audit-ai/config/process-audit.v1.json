  ],
  "criteria": [
    {"id":"A01","domain":"A","en":"Accountable process owner and authority are approved.","ar":"تم اعتماد مالك العملية وصلاحياته.","iso_clause":"5.3","dgep_alignment":"Process governance","weight":5,"mandatory":true,"evidence_examples":["approved ownership register"],"test_method":"document review and interview","effective_date":"2026-08-22","version":"1.0","active":true,"critical":true},
    {"id":"B01","domain":"B","en":"Current approved process version defines inputs, outputs, sequence and controls.","ar":"تحدد النسخة المعتمدة الحالية المدخلات والمخرجات والتسلسل والضوابط.","iso_clause":"4.4,7.5","dgep_alignment":"Process documentation","weight":5,"mandatory":true,"evidence_examples":["approved process model"],"test_method":"document review","effective_date":"2026-08-22","version":"1.0","active":true,"critical":true},
    {"id":"C01","domain":"C","en":"Sampled transactions follow the approved sequence and approvals.","ar":"تتبع المعاملات المختارة التسلسل والاعتمادات المعتمدة.","iso_clause":"8.1","dgep_alignment":"Execution conformance","weight":7,"mandatory":true,"evidence_examples":["transactions and logs"],"test_method":"sample and walkthrough","effective_date":"2026-08-22","version":"1.0","active":true,"critical":true},
    {"id":"D01","domain":"D","en":"Assigned roles are competent and aware of current requirements.","ar":"الأدوار المكلفة مؤهلة ومدركة للمتطلبات الحالية.","iso_clause":"7.2,7.3","dgep_alignment":"Capability","weight":4,"mandatory":true,"evidence_examples":["RACI and training"],"test_method":"interview and record review","effective_date":"2026-08-22","version":"1.0","active":true,"critical":false},
    {"id":"E01","domain":"E","en":"Process risks and controls are current, linked and operating.","ar":"مخاطر وضوابط العملية محدثة ومترابطة وفعالة.","iso_clause":"6.1,8.1","dgep_alignment":"Risk-based process management","weight":7,"mandatory":true,"evidence_examples":["risk register and control evidence"],"test_method":"control test","effective_date":"2026-08-22","version":"1.0","active":true,"critical":true},
    {"id":"F01","domain":"F","en":"Applicable legal, regulatory and policy requirements are identified and evidenced.","ar":"تم تحديد وإثبات المتطلبات القانونية والتنظيمية والسياسات ذات الصلة.","iso_clause":"4.2,8.2","dgep_alignment":"Compliance","weight":6,"mandatory":true,"evidence_examples":["obligation register"],"test_method":"traceability review","effective_date":"2026-08-22","version":"1.0","active":true,"critical":true},
    {"id":"G01","domain":"G","en":"KPIs have owners, definitions, targets, sources and reviewed results.","ar":"لمؤشرات الأداء ملاك وتعريفات ومستهدفات ومصادر ونتائج مراجعة.","iso_clause":"9.1","dgep_alignment":"Performance management","weight":6,"mandatory":true,"evidence_examples":["KPI register and results"],"test_method":"recalculation and interview","effective_date":"2026-08-22","version":"1.0","active":true,"critical":false},
    {"id":"H01","domain":"H","en":"Cycle time, effort, waste and capacity are measured and acted upon.","ar":"يتم قياس زمن الدورة والجهد والهدر والطاقة واتخاذ الإجراءات.","iso_clause":"8.1,10.3","dgep_alignment":"Efficiency","weight":4,"mandatory":false,"evidence_examples":["process analytics"],"test_method":"analytical review","effective_date":"2026-08-22","version":"1.0","active":true,"critical":false},
    {"id":"I01","domain":"I","en":"Stakeholder and service requirements are translated into process controls and measures.","ar":"تترجم متطلبات المعنيين والخدمات إلى ضوابط ومقاييس للعملية.","iso_clause":"4.2,8.2,9.1","dgep_alignment":"Integrated services","weight":5,"mandatory":true,"evidence_examples":["requirements and service levels"],"test_method":"traceability review","effective_date":"2026-08-22","version":"1.0","active":true,"critical":false},
    {"id":"J01","domain":"J","en":"Records and data are controlled, complete, retrievable and retained.","ar":"السجلات والبيانات مضبوطة ومكتملة وقابلة للاسترجاع والحفظ.","iso_clause":"7.5","dgep_alignment":"Evidence management","weight":6,"mandatory":true,"evidence_examples":["record samples and retention rules"],"test_method":"record sampling","effective_date":"2026-08-22","version":"1.0","active":true,"critical":true},
    {"id":"K01","domain":"K","en":"Systems support approved workflow, access and auditability.","ar":"تدعم الأنظمة سير العمل المعتمد والصلاحيات وقابلية التدقيق.","iso_clause":"7.1.3,7.1.5","dgep_alignment":"Digital enablement","weight":5,"mandatory":true,"evidence_examples":["system roles and logs"],"test_method":"system walkthrough","effective_date":"2026-08-22","version":"1.0","active":true,"critical":true},
    {"id":"L01","domain":"L","en":"Cross-unit handoffs, dependencies and end-to-end controls are defined and monitored.","ar":"تم تحديد ومراقبة التسليمات والاعتماديات والضوابط من طرف إلى طرف.","iso_clause":"4.4,8.4","dgep_alignment":"End-to-end integration","weight":6,"mandatory":true,"evidence_examples":["handoff records and OLA"],"test_method":"end-to-end walkthrough","effective_date":"2026-08-22","version":"1.0","active":true,"critical":true},
    {"id":"M01","domain":"M","en":"Process changes follow approved impact, authorization, publication and communication controls.","ar":"تتبع تغييرات العمليات ضوابط الأثر والاعتماد والنشر والتواصل.","iso_clause":"6.3,8.5.6","dgep_alignment":"Process change governance","weight":6,"mandatory":true,"evidence_examples":["change request and publication"],"test_method":"change sample","effective_date":"2026-08-22","version":"1.0","active":true,"critical":true},
    {"id":"N01","domain":"N","en":"Nonconformities are recorded and contained.","ar":"يتم تسجيل حالات عدم المطابقة واحتواؤها.","iso_clause":"10.2","dgep_alignment":"Corrective action","weight":4,"mandatory":true,"evidence_examples":["finding register"],"test_method":"finding sample","effective_date":"2026-08-22","version":"1.0","active":true,"critical":false},
    {"id":"N02","domain":"N","en":"Root causes are established using evidence.","ar":"يتم تحديد الأسباب الجذرية باستخدام الأدلة.","iso_clause":"10.2","dgep_alignment":"Corrective action","weight":4,"mandatory":true,"evidence_examples":["root-cause analysis"],"test_method":"case review","effective_date":"2026-08-22","version":"1.0","active":true,"critical":false},
    {"id":"N03","domain":"N","en":"CAPA owners and due dates are authorized.","ar":"تم اعتماد ملاك ومواعيد الإجراءات التصحيحية.","iso_clause":"10.2","dgep_alignment":"Corrective action","weight":3,"mandatory":true,"evidence_examples":["CAPA plan"],"test_method":"plan review","effective_date":"2026-08-22","version":"1.0","active":true,"critical":false},
    {"id":"N04","domain":"N","en":"Closure evidence is independently verified for effectiveness.","ar":"يتم التحقق المستقل من فعالية أدلة الإغلاق.","iso_clause":"10.2","dgep_alignment":"Corrective action verification","weight":5,"mandatory":true,"evidence_examples":["verification record"],"test_method":"effectiveness test","effective_date":"2026-08-22","version":"1.0","active":true,"critical":true},
    {"id":"N05","domain":"N","en":"Repeat findings are identified and escalated.","ar":"يتم تحديد النتائج المتكررة وتصعيدها.","iso_clause":"9.3,10.2","dgep_alignment":"Leadership oversight","weight":3,"mandatory":true,"evidence_examples":["trend and escalation"],"test_method":"trend analysis","effective_date":"2026-08-22","version":"1.0","active":true,"critical":false},
    {"id":"O01","domain":"O","en":"Improvement opportunities are maintained and prioritized.","ar":"يتم حفظ فرص التحسين وترتيب أولوياتها.","iso_clause":"10.3","dgep_alignment":"Continual improvement","weight":3,"mandatory":true,"evidence_examples":["improvement register"],"test_method":"register review","effective_date":"2026-08-22","version":"1.0","active":true,"critical":false},
    {"id":"O02","domain":"O","en":"Improvement decisions use process performance and stakeholder evidence.","ar":"تستخدم قرارات التحسين أدلة الأداء والمعنيين.","iso_clause":"9.1,10.3","dgep_alignment":"Evidence-led improvement","weight":3,"mandatory":true,"evidence_examples":["decision pack"],"test_method":"decision trace","effective_date":"2026-08-22","version":"1.0","active":true,"critical":false},
    {"id":"O03","domain":"O","en":"Benefits are baselined, owned and monitored.","ar":"يتم تحديد خط أساس للمنافع وملكيتها ومراقبتها.","iso_clause":"9.1,10.3","dgep_alignment":"Benefits realization","weight":3,"mandatory":false,"evidence_examples":["benefits register"],"test_method":"analytical review","effective_date":"2026-08-22","version":"1.0","active":true,"critical":false},
    {"id":"O04","domain":"O","en":"Lessons are communicated and standardized where applicable.","ar":"يتم تعميم الدروس وتوحيدها عند الاقتضاء.","iso_clause":"7.3,10.3","dgep_alignment":"Organizational learning","weight":2,"mandatory":false,"evidence_examples":["lesson record"],"test_method":"record review","effective_date":"2026-08-22","version":"1.0","active":true,"critical":false},
    {"id":"O05","domain":"O","en":"The process is reviewed annually and when audit, assessment, direction or trend triggers occur.","ar":"تراجع العملية سنوياً وعند وجود محفز تدقيق أو تقييم أو توجيه أو اتجاه.","iso_clause":"9.3,10.3","dgep_alignment":"Process review","weight":5,"mandatory":true,"evidence_examples":["review calendar and trigger record"],"test_method":"calendar and sample review","effective_date":"2026-08-22","version":"1.0","active":true,"critical":false}
  ],
  "severity_rules": {"critical_control_rating_0_2":"Major", "rating_0_1":"Major", "rating_2":"Minor", "rating_3":"Observation"},
  "gates": {
    "G1_PLAN": ["scope", "criteria_version", "lead_auditor", "process_owner"],
    "G2_FIELDWORK": ["approved_process_version", "sampling_plan", "evidence_plan"],
    "G3_FINDINGS": ["triangulated_evidence", "auditor_ratings", "finding_review"],
    "G4_CAPA": ["root_cause", "action_owner", "due_date", "approval"],
    "G5_CLOSURE": ["closure_evidence", "independent_verifier", "effectiveness_passed"]
  },
  "protected_actions": ["issue_formal_audit_opinion", "approve_final_rating", "issue_finding", "accept_root_cause", "approve_capa", "close_finding", "certify_iso_9001", "declare_dgep_compliance", "publish_assurance_report"]
}
