  "domains": [
    {"code":"A","en":"Governance & Ownership","ar":"الحوكمة والملكية"},
    {"code":"B","en":"Process Design & Documentation","ar":"تصميم وتوثيق العمليات"},
    {"code":"C","en":"Actual Execution & Conformance","ar":"التنفيذ الفعلي والمطابقة"},
    {"code":"D","en":"Roles, Competence & Awareness","ar":"الأدوار والكفاءة والوعي"},
    {"code":"E","en":"Risk & Controls","ar":"المخاطر والضوابط"},
    {"code":"F","en":"Legal, Regulatory & Policy Compliance","ar":"الامتثال القانوني والتنظيمي والسياساتي"},
    {"code":"G","en":"Performance","ar":"الأداء"},
    {"code":"H","en":"Efficiency & Productivity","ar":"الكفاءة والإنتاجية"},
    {"code":"I","en":"Stakeholder & Service Requirements","ar":"متطلبات المعنيين والخدمات"},
    {"code":"J","en":"Information, Records & Data","ar":"المعلومات والسجلات والبيانات"},
